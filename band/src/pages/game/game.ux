<template>
  <div class="page">
    <div if="{{screen === 'loading'}}" class="panel">
      <text class="title">Pickleball</text>
      <text class="hint">Loading game...</text>
    </div>
    <div if="{{screen === 'game'}}" class="panel gamePanel">
      <div class="row scoreLabels"><text class="teamLabel">US</text><text class="teamLabel">THEM</text></div>
      <div class="row scores"><text class="score">{{us}}</text><text class="score">{{them}}</text></div>
      <text class="serve">{{serveLabel}}</text>
      <text class="status" onclick="connectionSettings">{{phoneStatus}}</text>
      <div class="rallyButton ours" onclick="weWon">
        <text class="rallyTitle oursText">We won</text><text class="rallyCaption oursText">the rally</text>
      </div>
      <div class="rallyButton theirs" onclick="theyWon">
        <text class="rallyTitle">They won</text><text class="rallyCaption">the rally</text>
      </div>
      <div class="row gameActions">
        <div class="smallButton third" onclick="undo"><text class="smallText">Undo</text></div>
        <div class="smallButton third" onclick="repeat"><text class="smallText">Speak</text></div>
        <div class="smallButton third" onclick="more"><text class="smallText">More</text></div>
      </div>
      <text class="foot">{{notice}}</text>
    </div>
    <div if="{{screen === 'more'}}" class="panel">
      <text class="title">Game options</text>
      <text class="menuCall">{{scoreCall}}</text>
      <div class="button" onclick="edit"><text class="buttonText">Correct score</text></div>
      <div class="button" onclick="connectionSettings"><text class="buttonText">Phone connection</text></div>
      <div class="button" onclick="settings"><text class="buttonText">New game</text></div>
      <div class="button" onclick="back"><text class="buttonText">Back to game</text></div>
    </div>
    <div if="{{screen === 'edit'}}" class="panel">
      <text class="title">Correct score</text>
      <text class="hint">Save to announce</text>
      <text class="fieldLabel">Our points</text>
      <div class="row stepper">
        <div class="smallButton stepButton" onclick="usMinus"><text class="stepText">−</text></div>
        <text class="editValue">{{editUs}}</text>
        <div class="smallButton stepButton" onclick="usPlus"><text class="stepText">+</text></div>
      </div>
      <text class="fieldLabel">Their points</text>
      <div class="row stepper">
        <div class="smallButton stepButton" onclick="themMinus"><text class="stepText">−</text></div>
        <text class="editValue">{{editThem}}</text>
        <div class="smallButton stepButton" onclick="themPlus"><text class="stepText">+</text></div>
      </div>
      <div class="button compact" onclick="switchServing"><text class="buttonText">Serving: {{editServing}}</text></div>
      <div if="{{isDoubles}}" class="button compact" onclick="switchServer"><text class="buttonText">Server: {{editServer}}</text></div>
      <div class="button primary" onclick="saveEdit"><text class="primaryText">Save &amp; speak</text></div>
      <div class="smallButton wide" onclick="back"><text class="smallText">Cancel</text></div>
    </div>
    <div if="{{screen === 'new'}}" class="panel">
      <text class="title">New game</text>
      <text class="hint">Side-out · win by two</text>
      <div class="button compact" onclick="toggleMode"><text class="buttonText">{{newMode}}</text></div>
      <div class="button compact" onclick="toggleFirst"><text class="buttonText">First serve: {{newFirst}}</text></div>
      <div class="button compact" onclick="toggleTarget"><text class="buttonText">Play to {{newTarget}}</text></div>
      <text if="{{newWarning !== ''}}" class="warning">{{newWarning}}</text>
      <div class="button primary" onclick="startGame"><text class="primaryText">Start game</text></div>
      <div class="row footerActions">
        <div class="smallButton half" onclick="connectionSettings"><text class="smallText">Phone link</text></div>
        <div if="{{hasGame}}" class="smallButton half" onclick="back"><text class="smallText">Cancel</text></div>
      </div>
    </div>
    <div if="{{screen === 'connection'}}" class="panel">
      <text class="title">Phone link</text>
      <text class="linkStatus">{{phoneStatus}}</text>
      <list class="linkScroll">
        <list-item type="details" class="linkItem">
          <text class="bodyText">{{linkDetails}}</text>
          <text class="bodyText muted">Keep Notify connected and the phone announcer running.</text>
        </list-item>
      </list>
      <text class="hint">Swipe details to read more</text>
      <div class="button primary" onclick="reconnect"><text class="primaryText">Reconnect</text></div>
      <div class="smallButton wide" onclick="connectionBack"><text class="smallText">Back</text></div>
      <text class="foot">Your game is kept.</text>
    </div>
  </div>
</template>
<script>
import storage from '@system.storage';
import interconnect from '@system.interconnect';
import vibrator from '@system.vibrator';
const rules = require('../../common/scoring');
let game, draft, connection, heartbeat, ackTimer, session, sequence, challenge;
let linkGeneration = 0, alive = false;
let busy = false;
export default {
  private: {
    screen: 'loading', us: 0, them: 0, scoreCall: '0 - 0 - 2', serveLabel: '',
    phoneStatus: 'Phone offline', linkDetails: 'Tap Reconnect to check the phone link.', connectionReturn: 'game', notice: '', editUs: 0, editThem: 0,
    editServing: 'Us', editServer: 2, isDoubles: true,
    newMode: 'Doubles', newFirst: 'Us', newTarget: 11, hasGame: false, newWarning: ''
  },
  onInit() {
    game = null; busy = false; sequence = 0; challenge = ''; alive = true;
    session = Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 10);
    this.refreshConnection(false);
    storage.get({key: 'pickleball.game.v1', default: '', success: value => {
      if (value) {
        try { game = rules.restore(value); this.render(); this.screen = 'game'; }
        catch (_) { this.newWarning = 'Saved game unreadable. Start a new game to replace it.'; this.screen = 'new'; }
      } else { this.screen = 'new'; }
      this.hello();
    }, fail: () => { this.newWarning = 'Could not read saved game.'; this.screen = 'new'; this.hello(); }});
  },
  onShow() {
    this.refreshConnection(false);
    clearInterval(heartbeat);
    heartbeat = setInterval(() => {
      if (!challenge) this.hello();
    }, 8000);
  },
  onHide() { clearInterval(heartbeat); },
  onDestroy() {
    alive = false; ++linkGeneration;
    clearInterval(heartbeat); clearTimeout(ackTimer);
    this.unbindConnection();
  },
  unbindConnection() {
    if (!connection) return;
    connection.onmessage = null; connection.onopen = null;
    connection.onclose = null; connection.onerror = null;
  },
  connectionSettings() {
    this.connectionReturn = this.screen;
    this.screen = 'connection';
    this.reconnect();
  },
  connectionBack() { this.screen = this.connectionReturn; },
  reconnect() { this.refreshConnection(true); },
  refreshConnection(diagnose) {
    // Vela owns the physical connection. Reacquire its singleton and retry our
    // handshake; never replace the saved game to refresh communication.
    const generation = ++linkGeneration;
    challenge = ''; clearTimeout(ackTimer);
    this.unbindConnection(); connection = null;
    this.phoneStatus = 'Connecting...';
    this.linkDetails = 'Waiting for the phone app. Keep Notify and the announcer running.';
    try { connection = interconnect.instance(); }
    catch (error) { this.phoneStatus = 'Connection unavailable'; this.linkDetails = String(error); return; }
    const current = () => alive && generation === linkGeneration;
    connection.onopen = () => { if (current()) { challenge = ''; this.hello(); } };
    connection.onclose = event => {
      if (!current()) return;
      challenge = ''; clearTimeout(ackTimer);
      this.phoneStatus = 'Phone offline'; this.linkDetails = this.connectionError('Closed', event);
    };
    connection.onerror = event => {
      if (!current()) return;
      challenge = ''; clearTimeout(ackTimer);
      this.phoneStatus = 'Connection error'; this.linkDetails = this.connectionError('Link', event);
    };
    connection.onmessage = event => {
      if (!current()) return;
      try {
        const raw = event.data;
        const msg = typeof raw === 'string' ? JSON.parse(raw) : raw;
        if (msg.type === 'hello' && typeof msg.challenge === 'string') {
          clearTimeout(ackTimer);
          challenge = msg.challenge;
          this.phoneStatus = 'Phone connected';
          this.linkDetails = 'Phone handshake received.';
          if (game) this.send('sync');
        } else if (msg.type === 'ack' && msg.session === session && msg.sequence === sequence) {
          clearTimeout(ackTimer);
          if (msg.status === 'spoken') this.phoneStatus = 'Score spoken';
          else if (msg.status === 'speaking') {
            this.phoneStatus = 'Phone speaking...';
            ackTimer = setTimeout(() => { this.phoneStatus = 'Speech not confirmed'; }, 15000);
          }
          else if (msg.status === 'synced') { this.phoneStatus = 'Phone connected'; this.linkDetails = 'Score synchronized with the phone.'; }
          else this.phoneStatus = 'Speech unavailable';
        }
      } catch (_) { this.phoneStatus = 'Connection error'; this.linkDetails = 'Phone sent an unreadable message.'; }
    };
    connection.getReadyState({success: result => {
      if (!current() || challenge) return;
      this.linkDetails = result.status === 1 ? 'Band link ready. Waiting for the phone app handshake.' : 'Band link disconnected (state ' + result.status + ').';
    }, fail: (error, code) => { if (current() && !challenge) this.linkDetails = this.connectionError('State', error, code); }});
    this.hello();
    if (diagnose && typeof connection.diagnosis === 'function') {
      try { connection.diagnosis({timeout: 10000, success: result => {
        if (!current() || challenge) return;
        const reasons = {0: 'Link ready; phone app has not replied.', 204: 'Connection timed out. Keep Notify and the phone app open.', 1001: 'Phone companion not found by the band. Open Pickleball on the phone.', 1000: 'Connection failed. Check the phone connection details.'};
        this.linkDetails = 'Diagnosis ' + result.status + ': ' + (reasons[result.status] || 'Unknown connection result.');
      }, fail: (error, code) => { if (current() && !challenge) this.linkDetails = this.connectionError('Diagnosis', error, code); }}); }
      catch (error) { if (!challenge) this.linkDetails = 'Diagnosis unavailable. ' + String(error); }
    }
  },
  connectionError(source, error, code) {
    const detail = error && typeof error === 'object' ? error : {};
    const number = code === undefined ? detail.code : code;
    const message = detail.data || detail.message || (typeof error === 'string' ? error : 'No details');
    return source + (number === undefined ? '' : ' ' + number) + ': ' + String(message).slice(0, 160);
  },
  render() {
    const s = game.state;
    this.hasGame = true; this.us = s.scores[0]; this.them = s.scores[1];
    this.scoreCall = rules.call(s); this.isDoubles = s.mode === 'doubles';
    const won = rules.winner(s);
    this.serveLabel = won !== -1 ? (won === 0 ? 'We win!' : 'They win!') :
      (s.serving === 0 ? 'We serve' : 'They serve') + (this.isDoubles ? ' / server ' + s.server : '');
    this.notice = won !== -1 ? 'Game over - Undo or New' : (s.mode === 'doubles' ? 'Doubles' : 'Singles') + ' / to ' + s.target;
  },
  hello() {
    if (!connection || !alive) return;
    const generation = linkGeneration;
    connection.send({data: {type: 'hello'}, fail: (error, code) => {
      if (!alive || generation !== linkGeneration || challenge) return;
      this.phoneStatus = 'Phone offline';
      // Preserve an explicit diagnosis instead of replacing it on every retry.
      if (this.linkDetails.indexOf('Diagnosis ') !== 0) this.linkDetails = this.connectionError('Send', error, code);
    }});
  },
  send(action) {
    if (!challenge) { this.phoneStatus = 'Phone offline - score saved'; this.hello(); return; }
    sequence++;
    const p = rules.packet(game, action, sequence, session);
    p.challenge = challenge;
    const sent = sequence;
    this.phoneStatus = action === 'sync' ? 'Connecting...' : 'Sending score...';
    clearTimeout(ackTimer);
    ackTimer = setTimeout(() => { if (sent === sequence) { challenge = ''; this.phoneStatus = 'Phone not responding'; } }, 7000);
    connection.send({data: p, fail: () => {
      if (sent !== sequence) return;
      clearTimeout(ackTimer); challenge = ''; this.phoneStatus = 'Phone offline - score saved';
    }});
  },
  save(next, action) {
    if (busy || next === game) return;
    busy = true;
    storage.set({key: 'pickleball.game.v1', value: JSON.stringify(next), success: () => {
      game = next; busy = false; this.screen = 'game'; this.render();
      try { vibrator.vibrate({mode: 'short'}); } catch (_) {}
      this.send(action);
    }, fail: () => { busy = false; this.notice = 'Save failed - try again'; this.newWarning = 'Save failed - try again'; }});
  },
  weWon() { if (game) this.save(rules.rally(game, 0), 'rally'); },
  theyWon() { if (game) this.save(rules.rally(game, 1), 'rally'); },
  undo() { if (game) { if (!game.history.length) { this.notice = 'Nothing to undo'; return; } this.save(rules.undo(game), 'undo'); } },
  repeat() { if (game && !busy) this.send('repeat'); },
  edit() {
    if (!game || busy) return;
    draft = JSON.parse(JSON.stringify(game.state)); this.editUs = draft.scores[0]; this.editThem = draft.scores[1];
    this.editServing = draft.serving === 0 ? 'Us' : 'Them'; this.editServer = draft.server; this.screen = 'edit';
  },
  usMinus() { this.editUs = Math.max(0, this.editUs - 1); },
  usPlus() { this.editUs = Math.min(99, this.editUs + 1); },
  themMinus() { this.editThem = Math.max(0, this.editThem - 1); },
  themPlus() { this.editThem = Math.min(99, this.editThem + 1); },
  switchServing() { this.editServing = this.editServing === 'Us' ? 'Them' : 'Us'; },
  switchServer() { this.editServer = this.editServer === 1 ? 2 : 1; },
  saveEdit() {
    draft.scores = [this.editUs, this.editThem]; draft.serving = this.editServing === 'Us' ? 0 : 1;
    draft.server = this.editServer; this.save(rules.correct(game, draft), 'correct');
  },
  more() { if (!busy) this.screen = 'more'; },
  settings() { if (!busy) { this.newWarning = 'Replaces this game and its undo history.'; this.screen = 'new'; } },
  toggleMode() { this.newMode = this.newMode === 'Doubles' ? 'Singles' : 'Doubles'; },
  toggleFirst() { this.newFirst = this.newFirst === 'Us' ? 'Them' : 'Us'; },
  toggleTarget() { this.newTarget = this.newTarget === 11 ? 15 : this.newTarget === 15 ? 21 : 11; },
  startGame() { this.save(rules.create(this.newMode.toLowerCase(), this.newFirst === 'Us' ? 0 : 1, this.newTarget), 'start'); },
  back() { if (!busy) this.screen = 'game'; }
};
</script>
<style>
/* Band 10: 212 × 520. The centered 180 × 448 panel leaves room for the
   rounded display ends. Game content fits without scrolling or shrinking. */
.page { width: 212px; height: 520px; background-color: #071510; color: #ffffff; flex-direction: column; align-items: center; justify-content: center; }
.panel { width: 180px; height: 448px; flex-direction: column; align-items: center; justify-content: center; }
.row { width: 180px; flex-direction: row; align-items: center; justify-content: space-between; }
.title { width: 160px; height: 30px; font-size: 20px; line-height: 26px; color: #baf75e; text-align: center; lines: 1; }
.hint { width: 180px; height: 26px; font-size: 13px; line-height: 18px; color: #a4b7ac; text-align: center; lines: 1; }
.scoreLabels { height: 20px; }
.teamLabel { width: 86px; height: 20px; font-size: 13px; line-height: 18px; color: #a4b7ac; text-align: center; lines: 1; }
.scores { height: 58px; }
.score { width: 86px; height: 58px; font-size: 48px; line-height: 56px; color: #ffffff; text-align: center; lines: 1; }
.serve { width: 180px; height: 22px; font-size: 14px; line-height: 20px; color: #ffffff; text-align: center; lines: 1; }
.status { width: 172px; height: 32px; font-size: 12px; line-height: 15px; color: #a4d7bf; text-align: center; lines: 2; }
.rallyButton { width: 180px; height: 100px; margin-bottom: 8px; border-radius: 18px; flex-direction: column; align-items: center; justify-content: center; }
.ours { background-color: #baf75e; }
.theirs { background-color: #285e4b; }
.rallyTitle { width: 164px; height: 34px; font-size: 27px; line-height: 32px; color: #ffffff; text-align: center; lines: 1; }
.rallyCaption { width: 164px; height: 20px; font-size: 15px; line-height: 20px; color: #ffffff; text-align: center; lines: 1; }
.oursText { color: #10240a; }
.gameActions { height: 44px; margin-top: 8px; }
.smallButton { height: 44px; background-color: #20382c; border-radius: 12px; align-items: center; justify-content: center; }
.third { width: 56px; }
.half { width: 86px; }
.wide { width: 160px; }
.smallText { font-size: 14px; line-height: 20px; color: #ffffff; text-align: center; lines: 1; }
.foot { width: 160px; height: 36px; font-size: 12px; line-height: 16px; color: #a4b7ac; text-align: center; lines: 2; }
.button { width: 180px; height: 52px; margin-bottom: 8px; background-color: #20382c; border-radius: 14px; align-items: center; justify-content: center; }
.compact { height: 44px; }
.buttonText { width: 164px; font-size: 17px; line-height: 22px; color: #ffffff; text-align: center; lines: 1; }
.primary { background-color: #baf75e; }
.primaryText { width: 164px; font-size: 18px; line-height: 24px; color: #10240a; text-align: center; lines: 1; }
.menuCall { width: 180px; height: 40px; font-size: 22px; line-height: 32px; color: #ffffff; text-align: center; lines: 1; }
.fieldLabel { width: 180px; height: 20px; font-size: 14px; line-height: 18px; color: #a4b7ac; text-align: center; lines: 1; }
.stepper { height: 48px; margin-bottom: 8px; }
.stepButton { width: 56px; height: 48px; }
.stepText { width: 48px; font-size: 28px; line-height: 36px; color: #ffffff; text-align: center; lines: 1; }
.editValue { width: 60px; height: 40px; font-size: 30px; line-height: 38px; color: #ffffff; text-align: center; lines: 1; }
.warning { width: 172px; height: 60px; font-size: 13px; line-height: 18px; color: #e1c589; text-align: center; lines: 3; }
.footerActions { height: 44px; }
.linkStatus { width: 172px; height: 44px; font-size: 17px; line-height: 21px; color: #baf75e; text-align: center; lines: 2; }
.linkScroll { width: 180px; height: 176px; margin-bottom: 8px; }
.linkItem { width: 180px; flex-direction: column; }
.bodyText { width: 172px; font-size: 15px; line-height: 21px; color: #ffffff; margin-bottom: 16px; }
.muted { color: #a4b7ac; }
</style>
